---
// A LAYOUT is a reusable page shell. Every page renders its own content inside
// this one, so the <head>, header and footer are written once, not per page.
//
// `Astro.props` holds values passed in from the page that uses this layout,
// e.g. <Layout title="Přihláška">. The `= '...'` parts are defaults.
import '../styles/global.css';

const {
  title,
  description = 'Certifikace pro české výrobce, kteří nepoužívají vejce z klecových chovů.',
} = Astro.props;

// Defined once here so the header and footer can't drift apart.
const nav = [
  { href: '/#jak-to-funguje', label: 'Jak to funguje' },
  { href: '/#podminky',       label: 'Podmínky' },
  { href: '/#caste-dotazy',   label: 'Časté dotazy' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Slušně vychovaná vejce</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/pan-vajicko.svg" type="image/svg+xml" />
  </head>

  <body>
    <!-- Lets a keyboard or screen-reader user jump past the nav. Visually
         hidden until it receives focus. -->
    <a class="skip" href="#obsah">Přeskočit na obsah</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a href="/" class="brand" aria-label="Slušně vychovaná vejce — domů">
          <img src="/pan-vajicko.svg" alt="" width="28" height="36" />
          <span>Slušně vychovaná vejce</span>
        </a>

        <nav aria-label="Hlavní navigace">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>

        <a href="/prihlaska" class="btn btn--primary btn--sm">Podat přihlášku</a>
      </div>
    </header>

    <!-- Whatever the page puts inside <Layout> … </Layout> lands here. -->
    <main id="obsah"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <p><strong>Slušně vychovaná vejce</strong> — certifikační program spolku OBRAZ – Obránci zvířat.</p>
        <p class="site-footer__links">
          <a href="/zasady-ochrany-osobnich-udaju">Zásady ochrany osobních údajů</a>
          <a href="https://obrancizvirat.cz/">obrancizvirat.cz</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<!-- Styles in an Astro component are SCOPED by default: these rules apply only
     to markup in this file, so `.brand` here can never collide with a `.brand`
     defined in another component. -->
<style>
  .skip {
    position: absolute; left: -9999px;
    background: var(--ink); color: var(--shell);
    padding: 0.75rem 1rem; border-radius: 0 0 8px 0; z-index: 10;
  }
  .skip:focus { left: 0; top: 0; }

  .site-header {
    border-bottom: 1px solid var(--line);
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--shell) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .site-header__inner {
    display: flex; align-items: center; gap: 1.5rem;
    min-height: 4.25rem; flex-wrap: wrap;
  }

  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-weight: 800; text-decoration: none; letter-spacing: -0.02em;
    margin-inline-end: auto;
  }
  .brand img { display: block; }

  nav ul {
    display: flex; gap: 1.5rem;
    list-style: none; margin: 0; padding: 0;
  }
  nav a {
    text-decoration: none; font-weight: 600;
    border-bottom: 2px solid transparent; padding-block: 0.15rem;
  }
  nav a:hover { border-bottom-color: var(--yolk); }

  .btn--sm { padding: 0.55rem 1.1rem; font-size: 0.95rem; }

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--shell-warm);
    padding-block: 3rem;
    font-size: 0.95rem; color: var(--ink-soft);
  }
  .site-footer__links { display: flex; gap: 1.5rem; flex-wrap: wrap; }

  /* On a phone the nav would push the button onto its own cramped row, so
     the links drop below the brand instead. */
  @media (max-width: 46rem) {
    .site-header__inner { padding-block: 0.9rem; gap: 0.9rem; }
    .brand { margin-inline-end: 0; flex: 1 1 100%; }
    nav ul { gap: 1.1rem; flex-wrap: wrap; }
  }
</style>
