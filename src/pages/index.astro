---
import Layout from '../layouts/Layout.astro';

// Content lives in plain arrays at the top of the file rather than being typed
// out in the markup below. It keeps the template readable, and it means moving
// this into a CMS or a translation file later is a copy-paste, not a rewrite.
const benefits = [
  {
    title: 'Značka na obalu',
    body: 'Pan Vajíčko na vašich výrobcích. Zákazník pozná na první pohled, že uvnitř nejsou klecová vejce — bez čtení drobného písma.',
  },
  {
    title: 'Zápis do veřejného seznamu',
    body: 'Vaše firma se objeví v přehledu certifikovaných výrobců, kam odkazujeme z našich kampaní i z médií.',
  },
  {
    title: 'Ověří nezávislý auditor',
    body: 'Certifikaci nestavíme na vašem čestném prohlášení. Spolupracujeme s nezávislým auditorem, který dodavatelský řetězec skutečně prověří. Proto značka něco znamená.',
  },
];
---

<Layout title="Certifikace pro výrobce">

  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1>Slušně vychovaná vejce</h1>
        <p class="lead">
          Certifikace původu vaječné suroviny — od skořápkových vajec po sušený bílek
          v premixu. Doložíme celý řetězec až ke kódu chovu a potvrdíme, že
          v certifikovaných produktech nejsou vejce z klecí.
        </p>
        <div class="hero__actions">
          <a href="/prihlaska" class="btn btn--primary">Podat přihlášku</a>
          <a href="#jak-to-funguje" class="btn btn--ghost">Jak to funguje</a>
        </div>
      </div>

      <!-- aria-hidden: the mark is decorative here because the <h1> right next
           to it already says the same words. Announcing it twice is noise for
           anyone using a screen reader. -->
      <div class="hero__mark" aria-hidden="true">
        <img src="/pan-vajicko.svg" alt="" width="260" height="338" />
      </div>
    </div>
  </section>

  <section class="gap">
    <div class="wrap">
      <h2>Zákaz od roku 2027 sám o sobě nestačí.</h2>
      <p class="lead lead--tight">
        Od 1. ledna 2027 je chov nosnic v klecích v Česku zakázán. Zákaz je ale národní.
        Nevztahuje se na vejce a vaječné produkty dovezené z jiných států EU ani ze třetích zemí,
        kde klecové chovy zůstávají legální. A u zpracovaných surovin — melanže, sušeného bílku
        a žloutku, vaječného prášku v premixech — není způsob chovu povinně značen vůbec.
      </p>
      <p class="gap__punch">
        Právě tam, kde zákonná povinnost končí, začíná certifikace.
      </p>
    </div>
  </section>

  <section class="benefits">
    <div class="wrap">
      <h2>Co certifikace přináší</h2>
      <ul class="cards">
        {benefits.map((item) => (
          <li class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="tiers" id="jak-to-funguje">
    <div class="wrap">
      <h2>Ze slibu se stal doklad.</h2>
      <p class="lead lead--tight">
        Roky jsme na <a href="https://firmybezkleci.cz/">firmybezkleci.cz</a> vedli seznam firem,
        které slíbily, že od klecových vajec odejdou. Certifikace <strong>Slušně vychovaná vejce</strong>
        tento seznam nahrazuje a doplňuje to, co slibu chybělo: nezávislé ověření.
      </p>

      <div class="compare">
        <div class="compare__col">
          <p class="compare__label">Dosud</p>
          <h3>Veřejný závazek</h3>
          <p>Firma slíbila, že přestane odebírat vejce z klecových chovů. Seznam stál na důvěře — nikdo sliby neověřoval.</p>
          <p class="compare__meta">Příslib do budoucna · bez kontroly</p>
        </div>

        <div class="compare__col compare__col--strong">
          <p class="compare__label">Nově</p>
          <h3>Certifikace</h3>
          <p>Nezávislý auditor prověří dodavatelský řetězec a potvrdí, že firma klecová vejce nepoužívá — v žádném výrobku a v žádné formě.</p>
          <p class="compare__meta">Ověřený současný stav · právo užívat značku</p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .hero { padding-block: clamp(3rem, 9vw, 7rem); }
  .hero__inner {
    display: grid; align-items: center; gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1.3fr 1fr;
  }
  .hero__mark { display: grid; place-items: center; }
  .hero__mark img { width: min(100%, 17rem); height: auto; }

  .lead { font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem); max-width: var(--measure); color: var(--ink-soft); }
  .lead--tight { margin-bottom: 2.5rem; }

  .hero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2rem; }

  .gap { background: var(--ink); color: var(--shell); }
  .gap .lead { color: color-mix(in srgb, var(--shell) 78%, transparent); }
  .gap__punch {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 700; max-width: var(--measure); margin: 0;
    border-left: 4px solid var(--yolk); padding-left: 1.25rem;
  }

  .benefits { background: var(--shell-warm); }
  .cards {
    list-style: none; margin: 2.5rem 0 0; padding: 0;
    display: grid; gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .card h3 { margin: 0 0 0.5rem; font-size: 1.2rem; }
  .card p { margin: 0; color: var(--ink-soft); }

  .compare { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  .compare__col { border: 1px solid var(--line); border-radius: 14px; padding: 1.75rem; }
  .compare__col--strong { border: 2px solid var(--ink); background: var(--shell-warm); }
  .compare__col h3 { font-size: 1.35rem; margin: 0 0 0.75rem; }
  .compare__col p { color: var(--ink-soft); }
  .compare__label {
    margin: 0 0 0.35rem; font-size: 0.8rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink);
  }
  .compare__meta { font-size: 0.9rem; font-weight: 600; }

  @media (max-width: 52rem) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__mark { order: -1; justify-items: start; }
    .hero__mark img { width: min(55%, 11rem); }
  }
</style>
